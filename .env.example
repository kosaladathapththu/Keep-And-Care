# Local development example. Prefer: npm run setup:local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=keepcare_dev
DB_USER=keepcare_dev
DB_PASSWORD=replace-with-your-local-database-password
DB_CONNECTION_LIMIT=5
APP_URL=http://localhost:3000
# Optional locally; required for first account creation on hosting.
# AUTH_SETUP_TOKEN=replace-with-a-long-private-random-value
